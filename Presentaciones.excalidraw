      "width": 240,
      "height": 18.4,
      "strokeColor": "#1971c2",
      "text": "JERARQUÍA DE OPERADORES",
      "fontSize": 16,
      "fontFamily": 7,
      "originalText": "JERARQUÍA DE OPERADORES",
      "lineHeight": 1.15,
      "version": 626,
      "versionNonce": 666134895,
