      "width": 290,
      "height": 18.4,
      "strokeColor": "#1971c2",
      "text": "ENTRADA → PROCESO → SALIDA",
      "fontSize": 16,
      "fontFamily": 7,
      "originalText": "ENTRADA → PROCESO → SALIDA",
