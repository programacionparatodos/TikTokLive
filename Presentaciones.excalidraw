    },
    {
      "id": "A14",
      "type": "text",
      "x": 404.597537878788,
      "y": -334.6961805555555,
      "width": 404.7929382324219,
      "height": 93.75,
      "strokeColor": "#343a40",
      "text": "• Preciso: sus instrucciones deben ser claras.\n• Ordenado: los pasos siguen una secuencia lógica.\n• Finito: debe terminar después de cierta cantidad de pasos.\n• Definido: los mismos datos producen el mismo resultado.\n• Efectivo: cada instrucción debe poder realizarse.",
      "fontSize": 15,
      "fontFamily": 6,
      "originalText": "• Preciso: sus instrucciones deben ser claras.\n• Ordenado: los pasos siguen una secuencia lógica.\n• Finito: debe terminar después de cierta cantidad de pasos.\n• Definido: los mismos datos producen el mismo resultado.\n• Efectivo: cada instrucción debe poder realizarse.",
      "lineHeight": 1.25,
      "version": 358,
      "versionNonce": 1377734510,
      "index": "a4",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
