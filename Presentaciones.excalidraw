    {
      "id": "A16",
      "type": "text",
      "x": 408.6174242424245,
      "y": 21.82553069760104,
      "width": 376.1877746582031,
      "height": 56.25,
      "strokeColor": "#343a40",
      "text": "Entrada: información que recibe el algoritmo.\nProceso: operaciones realizadas con los datos recibidos.\nSalida: resultado obtenido después del procesamiento.",
      "fontSize": 15,
      "fontFamily": 6,
      "originalText": "Entrada: información que recibe el algoritmo.\nProceso: operaciones realizadas con los datos recibidos.\nSalida: resultado obtenido después del procesamiento.",
      "lineHeight": 1.25,
