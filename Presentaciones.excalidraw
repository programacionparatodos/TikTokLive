    {
      "id": "A18",
      "type": "text",
      "x": 833.006628787879,
      "y": -341.2929292929291,
      "width": 380.0726318359375,
      "height": 56.25,
      "strokeColor": "#343a40",
      "text": "Utilizamos algoritmos incluso sin programar: al preparar\nuna receta, retirar dinero de un cajero, seguir una ruta\no realizar paso a paso cualquier actividad cotidiana.",
      "fontSize": 15,
      "fontFamily": 6,
      "originalText": "Utilizamos algoritmos incluso sin programar: al preparar\nuna receta, retirar dinero de un cajero, seguir una ruta\no realizar paso a paso cualquier actividad cotidiana.",
      "lineHeight": 1.25,
