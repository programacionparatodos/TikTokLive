      "width": 260,
      "height": 18.4,
      "strokeColor": "#1971c2",
      "text": "¿QUÉ ES UN ALGORITMO?",
      "fontSize": 16,
      "fontFamily": 7,
      "originalText": "¿QUÉ ES UN ALGORITMO?",
      "lineHeight": 1.15,
      "version": 81,
      "versionNonce": 789864366,
      "index": "a1",
      "isDeleted": false,
      "fillStyle": "solid",
