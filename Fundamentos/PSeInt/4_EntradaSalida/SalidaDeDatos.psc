Algoritmo SalidaDeDatos
	// Salida de un texto
	Escribir "Programación Para Todos";
	
	// Salida de una variable (valor)
	Definir nombre Como Cadena;
	nombre <- "Andrea Velasco";
	
	Escribir nombre;
	
	// Concatenación (texto + variable)
	Definir edad Como Entero;
	edad = 24;
	
	Escribir "Edad de TECNO: ", edad;
	
	// Salida de varios elementos
	Definir novia1, novia2 Como Cadena;
	novia1 = "Citlalli";
	novia2 = "Italika";
	Escribir novia1, " ", novia2;
	
	// Uso de saltos de línea
	Escribir "Primera línea";
	Escribir "Segunda línea";
	
	// Salida de un resultado
	Definir a, b, c, d Como Entero;
	a <- 6;
	b <- 2;
	c <- -3;
	d <- 1;
	Escribir (a * c) + (b * d);
	
FinAlgoritmo