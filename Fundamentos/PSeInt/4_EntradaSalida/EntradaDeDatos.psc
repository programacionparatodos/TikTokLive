Algoritmo EntradaDeDatos	
	// Entrada Individual
	Definir nombre Como Cadena;
	
	Leer nombre;
	
	// Entrada m?ltiple (l?neas separadas)
	Definir nombreCompleto Como Cadena;
	Definir edad Como Entero;
	Definir estatura Como Real;
	
	Leer nombreCompleto;
	Leer edad;
	Leer estatura;
	
	// Entrada m?ltiple (una l?nea)
	Definir a, b, c Como Entero;
	
	Leer a, b, c; 
	
	// Entrada con mensaje
	Definir numero1 Como Entero;
	
	Escribir "Ingrese un n?mero: ";
	Leer numero1;
	
FinAlgoritmo