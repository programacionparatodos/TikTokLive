Algoritmo TipoCadena
	
	// -------------------
    // TIPO DE DATO CADENA
    // -------------------
	
    // Representa una secuencia
    // de caracteres
	
    // Puede contener palabras,
    // frases, números y símbolos
	
	
    // --------
    // PALABRAS
    // --------
	
    Escribir "Hola";
    Escribir "PSeInt";
    Escribir "Programacion";
	
	
    // ------
    // FRASES
    // ------
	
    Escribir "Hola mundo";
    Escribir "Programacion Para Todos";
	
	
    // ------------------
    // NÚMEROS COMO TEXTO
    // ------------------
	
    Escribir "2026";
    Escribir "12345";
	
    // "2026" representa una cadena
	
    Escribir 2026;
	
    // 2026 representa un número
	
	
    // ------------
    // CADENA VACÍA
    // ------------
	
    Escribir "";
	
	
    // IMPORTANTE
    // Una cadena puede contener
    // uno o varios caracteres
	
FinAlgoritmo
