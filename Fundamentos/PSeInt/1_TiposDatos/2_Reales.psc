Algoritmo TipoReal
	
	// -----------------
    // TIPO DE DATO REAL
    // -----------------
	
    // Representa números que pueden
    // contener una parte decimal
	
    // Pueden ser positivos,
    // negativos o el cero
	
	
    // ----------------
    // REALES POSITIVOS
    // ----------------
	
    Escribir 3.14;
    Escribir 18.5;
    Escribir 125.75;
	
	
    // ----------------
    // REALES NEGATIVOS
    // ----------------
	
    Escribir -5.5;
    Escribir -18.75;
	
	
    // IMPORTANTE
    // Utilizamos el punto para
    // representar la parte decimal
	
    // 3.14
    // 19.99
    // -8.5
	
	
    // --------------------
    // EJEMPLOS DE USO REAL
    // --------------------
	
    // Estatura
    Escribir 1.75;
	
    // Temperatura
    Escribir 23.5;
	
    // Precio
    Escribir 49.99;
	
FinAlgoritmo
