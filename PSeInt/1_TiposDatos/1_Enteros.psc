Algoritmo TipoEntero
	
	// -------------------
    // TIPO DE DATO ENTERO
    // -------------------
	
    // Representa números que NO
    // contienen una parte decimal
	
    // Pueden ser positivos,
    // negativos o el cero
	
	
    // -----------------
    // NÚMEROS POSITIVOS
    // -----------------
	
    Escribir 25;
    Escribir 150;
    Escribir 2026;
	
	
    // ------------------
    // NÚMEROS NEGATIVOS
    // ------------------
	
    Escribir -10;
    Escribir -250;
    Escribir -3700;
	
	
    // ----
    // CERO
    // ----
	
    Escribir 0;
	
	
    // IMPORTANTE
    // Los números enteros se escriben
    // directamente, sin comillas
	
    // 25       Entero
    // -15      Entero
    // 0        Entero
	
	
    // ----------------------
    // EJEMPLOS DE USO ENTERO
    // ----------------------
	
    // Cantidad de estudiantes
    Escribir 35;
	
    // Número de vidas
    Escribir 3;
	
    // Temperatura bajo cero
    Escribir -8;
	
FinAlgoritmo
