Algoritmo TipoLogico
	
	// -------------------
    // TIPO DE DATO LÓGICO
    // -------------------
	
    // Representa únicamente
    // dos posibles estados
	
    // Verdadero
    // Falso
	
	
    // ---------
    // VERDADERO
    // ---------
	
    Escribir Verdadero;
	
    // Representa que una condición
    // o estado es verdadero
	
	
    // -----
    // FALSO
    // -----
	
    Escribir Falso;
	
    // Representa que una condición
    // o estado es falso
	
	
    // IMPORTANTE
    // Verdadero y Falso NO son textos
	
    Escribir Verdadero;
    Escribir "Verdadero";
	
    // Verdadero   -> Lógico
    // "Verdadero" -> Cadena
	
FinAlgoritmo
