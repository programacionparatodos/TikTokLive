Algoritmo TipoCaracter
	
	// ---------------------
    // TIPO DE DATO CARÁCTER
    // ---------------------
	
    // Representa un único
    // carácter
	
    // Puede ser una letra,
    // número o símbolo
	
	
    // ------
    // LETRAS
    // ------
	
    Escribir 'A';
    Escribir 'Z';
    Escribir 'a';
	
	
    // --------------------
    // NÚMERO COMO CARÁCTER
    // --------------------
	
    Escribir '7';
	
    // '7' representa un carácter
	
    Escribir 7;
	
    // 7 representa un número
	
	
    // --------
    // SÍMBOLOS
    // --------
	
    Escribir '@';
    Escribir '#';
    Escribir '$';
	
	
    // IMPORTANTE
    // Un carácter se encuentra
    // delimitado por comillas
	
FinAlgoritmo
