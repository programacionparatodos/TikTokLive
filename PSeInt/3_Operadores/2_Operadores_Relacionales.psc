Algoritmo OperadoresRelacionales
	
	Definir comparacion Como Logico;
	
	// Mayor que: >
	
	Escribir "Operador Mayor que: >";
	
	// Entero > Entero
	comparacion <- 10 > 5;
	// comparacion = Verdadero
	Escribir comparacion;
	
	// Real > Real
	comparacion <- 6.7 > 9.0;
	// comparacion = Falso
	Escribir comparacion;
	
	// Entero > Real
	comparacion <- 6 > 9.5;
	// comparacion = Falso
	Escribir comparacion;
	
	Escribir "";
	
	// Menor que: <
	
	Escribir "Operador Menor que: <";
	comparacion <- 10 < 5;
	// comparacion = Falso
	Escribir comparacion;
	
	comparacion <- 6.7 < 9.0;
	// comparacion = Verdadero
	Escribir comparacion;
	
	comparacion <- 6 < 9.5;
	// comparacion = Verdadero
	Escribir comparacion;
	
	Escribir "";
	
	// Mayor o igual que: >=
	
	Escribir "Operador Mayor o igual que: >=";
	comparacion <- 5 >= 5;
	// comparacion = Verdadero
	Escribir comparacion;
	
	comparacion <- 6.7 >= 9.0;
	// comparacion = Falso
	Escribir comparacion;
	
	comparacion <- 3 >= 3.0;
	// comparacion = Verdadero
	Escribir comparacion;
	
	Escribir "";
	
	// Menor o igual que: <=
	
	Escribir "Operador Menor o igual que: <=";
	comparacion <- 5 <= 5;
	// comparacion = Verdadero
	Escribir comparacion;
	
	comparacion <- 6.7 <= 9.0;
	// comparacion = Verdadero
	Escribir comparacion;
	
	comparacion <- 3 <= 3.0;
	// comparacion = Verdadero
	Escribir comparacion;
	
	Escribir "";
	
	// Igual que: ==
	
	Escribir "Operador Igual que: ==";
	Escribir "";
	Escribir "Tipo de Dato Numérico";
	
	// Entero == Entero
	comparacion <- 5 == 5;
	// comparacion = Verdadero
	Escribir comparacion;
	
	// Real == Real
	comparacion <- 6.7 == 9.0;
	// comparacion = Falso
	Escribir comparacion;
	
	// Entero == Real
	comparacion <- 3 == 3.0;
	// comparacion = Verdadero
	Escribir comparacion;
	
	Escribir "";
	
	Escribir "Tipo de Dato Alfanumérico";
	// Cadena == Cadena
	comparacion <- "Mauro" == "Mauro";
	// comparacion = Verdadero
	Escribir comparacion;
	
	// Caracter == Caracter
	comparacion <- 'M' == 'A';
	// comparacion = Falso
	Escribir comparacion;
	
	Escribir "";
	Escribir "Tipo de Dato Lógico";
	// Lógico == Lógico
	comparacion <- Verdadero == Falso;
	// comparacion = Falso
	Escribir comparacion;
	
	// Diferente que: <>
	
	Escribir "";
	Escribir "Operador Diferente que: <>";
	Escribir "";
	Escribir "Tipo de Dato Numérico";
	
	// Entero <> Entero
	comparacion <- 5 <> 5;
	// comparacion = Falso
	Escribir comparacion;
	
	// Real <> Real
	comparacion <- 6.7 <> 9.0;
	// comparacion = Verdadero
	Escribir comparacion;
	
	// Entero <> Real
	comparacion <- 3 <> 3.0;
	// comparacion = Falso
	Escribir comparacion;
	
	Escribir "";
	
	Escribir "Tipo de Dato Alfanumérico";
	// Cadena <> Cadena
	comparacion <- "Braulio" <> "Mauro";
	// comparacion = Verdadero
	Escribir comparacion;
	
	// Caracter <> Caracter
	comparacion <- 'T' <> 'A';
	// comparacion = Verdadero
	Escribir comparacion;
	
	Escribir "";
	Escribir "Tipo de Dato Lógico";
	// Lógico <> Lógico
	comparacion <- Verdadero <> Falso;
	// comparacion = Verdadero
	Escribir comparacion;
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
