Algoritmo Constantes
	
	// --------------------
    // CONSTANTES EN PSeInt
    // --------------------
	
    // Una constante representa un valor
    // que permanece sin cambios durante
    // la ejecución del algoritmo
	
    // PSeInt no posee una palabra
    // reservada específica como:
    
    // const
    // final
	
	
    // -------------------------
    // REPRESENTAR UNA CONSTANTE
    // -------------------------
	
    // Podemos utilizar una variable
    // cuyo valor decidimos NO modificar
	
    Definir VALOR_PI Como Real;
	
    VALOR_PI <- 3.1416;
	
    Escribir VALOR_PI;
	
	
    // Durante nuestro algoritmo
    // mantenemos siempre el mismo valor
	
	
    // --------------
    // OTROS EJEMPLOS
    // --------------
	
    Definir DIAS_SEMANA Como Entero;
    Definir MESES_ANIO Como Entero;
	
    DIAS_SEMANA <- 7;
    MESES_ANIO <- 12;
	
    Escribir DIAS_SEMANA;
    Escribir MESES_ANIO;
	
	
    // ----------------------
    // ONVENCIÓN DE ESCRITURA
    // ----------------------
	
    // Para diferenciarlas visualmente
    // de nuestras variables podemos
    // escribirlas en MAYÚSCULAS
	
    // VALOR_PI
    // DIAS_SEMANA
    // MESES_ANIO
	
	
    // IMPORTANTE
    // Esto es solamente una CONVENCIÓN
	
    // PSeInt NO impide modificar
    // posteriormente estos valores
	
    VALOR_PI <- 5;
	
    // Esta instrucción es válida
    // para PSeInt
	
    // Somos nosotros quienes debemos
    // respetar que el valor permanezca
    // sin modificaciones

FinAlgoritmo
