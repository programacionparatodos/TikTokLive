Algoritmo CatsAndDogs
	
	// * Declaración de variables
	Definir a, b, x Como Entero;
	
	// * Entrada de datos
	Leer a, b, x;	
	
	// * Proceso
	Si x >= a Y x <= a + b Entonces
		// * Salida de datos
		Escribir "YES";
	FinSi
	
	Si x < a O x > a + b Entonces
		// * Salida de datos
		Escribir "NO";
	FinSi
	
FinAlgoritmo