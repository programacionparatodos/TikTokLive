    {
      "id": "8a6WYG50V7Jnhdqz8Ut1V",
      "type": "text",
      "x": 393.4623521300779,
      "y": 2027.3361451945498,
      "width": 328.1289062499999,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
