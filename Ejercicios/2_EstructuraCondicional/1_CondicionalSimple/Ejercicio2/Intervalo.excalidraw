    {
      "id": "MjicOlfzsNTuz_H0yUvsh",
      "type": "text",
      "x": 817.9055512854495,
      "y": 2380.704353110032,
      "width": 327.4106005081246,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bXT",
      "roundness": null,
      "seed": 488839316,
      "version": 98,
      "versionNonce": 1635689440,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793981899762,
      "created": 1793945989808,
      "link": null,
      "locked": false,
      "text": "Algoritmo CatsAndDogs\n        Definir a, b, x Como Entero;    \n        Leer a, b, x;    \n        Si x >= a Y x <= a + b Entonces            \n                Escribir \"YES\";\n        FinSi\n        \n        Si x < a O x > a + b Entonces\n                Escribir \"NO\";\n        FinSi        \nFinAlgoritmo",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algoritmo CatsAndDogs\n        Definir a, b, x Como Entero;    \n        Leer a, b, x;    \n        Si x >= a Y x <= a + b Entonces            \n                Escribir \"YES\";\n        FinSi\n        \n        Si x < a O x > a + b Entonces\n                Escribir \"NO\";\n        FinSi        \nFinAlgoritmo",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
