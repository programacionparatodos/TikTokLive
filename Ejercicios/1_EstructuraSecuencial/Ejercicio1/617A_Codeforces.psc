Algoritmo Elephant617A
	
	// * Definición de variables
	Definir x, pasos Como Entero;
	
	// * Entrada de Datos
	Escribir "Ingrese el valor de x: ";
	Leer x;
	
	// * Proceso 
	pasos = TRUNC((x + 4) / 5);
	
	// * Salida de Datos
	Escribir "Pasos: ", pasos;
	
FinAlgoritmo