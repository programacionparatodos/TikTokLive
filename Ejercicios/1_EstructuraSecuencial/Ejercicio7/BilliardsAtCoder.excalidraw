    {
      "id": "4VdE0RwYm-49vsZCmF6ka",
      "type": "text",
      "x": 850.2223775046126,
      "y": 2391.1376828913253,
      "width": 287.21661376953125,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPm",
      "roundness": null,
      "seed": 502363973,
      "version": 161,
      "versionNonce": 92198059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793119056374,
      "created": 1793117758714,
      "link": null,
      "locked": false,
      "text": "Algoritmo BilliardsAtCoder\n        \n        Definir Sx, Sy, Gx, Gy Como Entero;\n        Definir x Como Real;\n\n        Leer Sx, Sy, Gx, Gy;\n\n        x = (Sx * Gy + Sy * Gx) / (Gy + Sy);\n\n        Escribir x;\n        \nFinAlgoritmo",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algoritmo BilliardsAtCoder\n        \n        Definir Sx, Sy, Gx, Gy Como Entero;\n        Definir x Como Real;\n\n        Leer Sx, Sy, Gx, Gy;\n\n        x = (Sx * Gy + Sy * Gx) / (Gy + Sy);\n\n        Escribir x;\n        \nFinAlgoritmo",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
