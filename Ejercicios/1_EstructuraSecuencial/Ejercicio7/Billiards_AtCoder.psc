
// TODO: Billiards - AtCoder

Algoritmo BilliardsAtCoder
	
	// * Definicion de variables
	Definir Sx, Sy, Gx, Gy Como Entero;
	Definir x Como Real;
	
	// * Entrada de datos
	Leer Sx, Sy, Gx, Gy;
	
	// * Proceso 
	x = (Sx * Gy + Sy * Gx) / (Gy + Sy);
	
	// * Salida de datos
	Escribir x;
	
FinAlgoritmo