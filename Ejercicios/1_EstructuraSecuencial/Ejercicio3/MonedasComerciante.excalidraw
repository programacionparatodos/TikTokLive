    {
      "id": "eVO-tesbhtog8_QSAqJNl",
      "type": "text",
      "x": 802.8052183044626,
      "y": 2388.6917580332492,
      "width": 365.15283203125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCr",
      "roundness": null,
      "seed": 2008201100,
      "version": 70,
      "versionNonce": 1072841524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792380854550,
      "created": 1792380836028,
      "link": null,
      "locked": false,
      "text": "Algoritmo MonedasComerciante\n        Definir N, C, B, resto Como Entero;\n        Definir cofres, bolsas, sobrantes Como Entero;\n        Leer N, C, B;\n        cofres <- trunc(N / C);\n        resto <- N % C;\n        bolsas <- trunc(resto / B);\n        sobrantes <- resto % B;\n        Escribir cofres, bolsas, sobrantes;\nFinAlgoritmo",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algoritmo MonedasComerciante\n        Definir N, C, B, resto Como Entero;\n        Definir cofres, bolsas, sobrantes Como Entero;\n        Leer N, C, B;\n        cofres <- trunc(N / C);\n        resto <- N % C;\n        bolsas <- trunc(resto / B);\n        sobrantes <- resto % B;\n        Escribir cofres, bolsas, sobrantes;\nFinAlgoritmo",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
