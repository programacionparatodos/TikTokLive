    {
      "id": "VzV4C1gIIdc5oCdrPuA0b",
      "type": "text",
      "x": 816.6277962858139,
      "y": 2480.2567599955,
      "width": 360.288818359375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMc",
      "roundness": null,
      "seed": 1588257696,
      "version": 127,
      "versionNonce": 865193888,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792893912242,
      "created": 1792893786545,
      "link": null,
      "locked": false,
      "text": "Algoritmo CountBalls\n        Definir n, a, b, t, g, z, r, e, azules Como Entero;\n                \n        Leer n, a, b;        \n        \n        t <- a + b;\n        g <- trunc(n / t);\n        z <- g * a;\n        r <- n % t;\n        e <- trunc((r + a - abs(r - a)) / 2);\n        azules <- z + e;\n\n        Escribir azules;\nFinAlgoritmo",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algoritmo CountBalls\n        Definir n, a, b, t, g, z, r, e, azules Como Entero;\n                \n        Leer n, a, b;        \n        \n        t <- a + b;\n        g <- trunc(n / t);\n        z <- g * a;\n        r <- n % t;\n        e <- trunc((r + a - abs(r - a)) / 2);\n        azules <- z + e;\n\n        Escribir azules;\nFinAlgoritmo",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
