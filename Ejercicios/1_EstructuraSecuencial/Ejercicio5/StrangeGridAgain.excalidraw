      "created": 1792513611475,
      "link": null,
      "locked": false,
      "text": "Algoritmo CalculatingFunction        \n        Definir n, fn Como Entero;\n        Leer n;\n        fn <- trunc(n / 2) - (n % 2) * n;\n        Escribir fn;        \nFinAlgoritmo",
      "fontSize": 18.416407425852487,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algoritmo CalculatingFunction        \n        Definir n, fn Como Entero;\n        Leer n;\n        fn <- trunc(n / 2) - (n % 2) * n;\n        Escribir fn;        \nFinAlgoritmo",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
