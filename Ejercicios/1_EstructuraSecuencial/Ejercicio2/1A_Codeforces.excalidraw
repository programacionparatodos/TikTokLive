    {
      "id": "EMCO3R9QsgnQPRyFwJD6m",
      "type": "text",
      "x": 833.888684604621,
      "y": 2520.0507575648658,
      "width": 327.28076171875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
