      "updated": 1792813506092,
      "created": 1792789417142,
      "link": null,
      "locked": false,
      "text": "Algoritmo TheatreSquare1A\n        Definir n, m, a, col, fil, total Como Entero;\n        Leer n, m, a;\n        col <- TRUNC((n + a - 1) / a);\n        fil <- TRUNC((m + a - 1) / a);\n        total <- col * fil;\n        Escribir total;\nFinAlgoritmo",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algoritmo TheatreSquare1A\n        Definir n, m, a, col, fil, total Como Entero;\n        Leer n, m, a;\n        col <- TRUNC((n + a - 1) / a);\n        fil <- TRUNC((m + a - 1) / a);\n        total <- col * fil;\n        Escribir total;\nFinAlgoritmo",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
