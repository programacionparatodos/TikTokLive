    {
      "id": "EMCO3R9QsgnQPRyFwJD6m",
      "type": "text",
      "x": 544.4558755420397,
      "y": 3485.820337282973,
      "width": 327.28076171875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
